# Copy to .env and adjust. See src/env.ts for descriptions.

# Public origin of the deployed site (no trailing slash). Used for canonical
# URLs, Open Graph tags and absolute links in /rss.xml. Set this before building
# for production.
SITE_URL=https://noesis.example

# SQLite file for shared editing. Must live on a persistent disk in production.
NOESIS_DB_PATH=data/noesis.db
